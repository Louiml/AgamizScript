{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agamiz Script",
  "version": "0.1.0",
  "identifier": "com.agamiz.script",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agamiz Script",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0b0b0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://generativelanguage.googleapis.com http://127.0.0.1:* http://localhost:*; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Screenplay, manuscript & subtitle writing suite",
    "longDescription": "Agamiz Script is a next-generation desktop suite for writing screenplays, manuscripts and subtitles, with friendlier formatting, revision tracking and AI assistance.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ascript"],
        "name": "Agamiz Script Project",
        "description": "Agamiz screenplay/manuscript/subtitle package",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ]
  }
}